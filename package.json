    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
